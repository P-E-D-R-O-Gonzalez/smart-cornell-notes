{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "cornell-note-ai",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-09-17",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "observability": {
        "enabled": true
    }
}